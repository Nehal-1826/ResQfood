# ============================================================
# ResQFood Environment Configuration
# ============================================================

# Application
PORT=3000
APP_URL=https://your-app.vercel.app

# Database Configuration (MySQL / TiDB / Aiven / PlanetScale / AWS RDS)
# Option 1: Connection string
DATABASE_URL=mysql://username:password@hostname:3306/foodbridge_db?sslmode=require

# Option 2: Individual variables
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foodbridge_db
DB_SSL=false

# JWT Authentication
JWT_SECRET=resqfood_jwt_super_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Email Service (Gmail SMTP)
EMAIL_USER=resqfoodnsk@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password

# Google Maps API (Optional)
GOOGLE_MAPS_API_KEY=

# ngrok for local development only (Optional)
NGROK_AUTH_TOKEN=
